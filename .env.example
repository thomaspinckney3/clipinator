# Copy this file to .env and fill in local values.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
OPENAI_CLIENT_TIMEOUT_SECONDS=1800
ELEVENLABS_CLIENT_TIMEOUT_SECONDS=1800

# Local response cache identity mode:
# strict = LLM query hash + stage source-file hashes
# query-only = LLM query hash only, useful when reviewing code-only changes
# off = disable local response cache
OPENAI_RESPONSE_CACHE_MODE=strict

# Default transcription settings. CLI flags override these values.
TRANSCRIBE_PROVIDER=openai
TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_OPENAI_MODEL=whisper-1
TRANSCRIBE_ELEVENLABS_MODEL=scribe_v2
TRANSCRIBE_LANGUAGE=en
TRANSCRIBE_OUTPUT_DIR=/Volumes/t9/extract/transcripts
TRANSCRIBE_PROMPT=NASA general-audience video about Artemis, astronauts, moon rocks, space exploration, scientific instruments, and training.
TRANSCRIBE_AUDIO_BITRATE_KBPS=64
TRANSCRIBE_MAX_UPLOAD_MB=24
TRANSCRIBE_WHISPER_1_USD_PER_MINUTE=0.006
TRANSCRIBE_ELEVENLABS_USD_PER_HOUR=0.40
TRANSCRIBE_ELEVENLABS_DIARIZE=false
TRANSCRIBE_ELEVENLABS_TAG_AUDIO_EVENTS=true
TRANSCRIBE_ELEVENLABS_NO_VERBATIM=false
TRANSCRIBE_ELEVENLABS_NUM_SPEAKERS=
TRANSCRIBE_ELEVENLABS_TEMPERATURE=
TRANSCRIBE_ELEVENLABS_SEED=

# Leave empty to let the CLI calculate a safe chunk size.
TRANSCRIBE_CHUNK_SECONDS=

# Cloudflare Stream capture defaults. The token needs Stream Read permission,
# and Stream Write when the utility has to generate downloadable MP4/M4A assets.
CLOUDFLARE_CAPTURE_OUTPUT_DIR=/Volumes/t9/extract/cloudflare-captures
CLOUDFLARE_CAPTURE_INDEX=/Volumes/t9/extract/cloudflare-captures/cloudflare-stream-index.json

# OpenAI first-stage planning defaults. CLI flags override these values.
STAGE1_MODEL=gpt-5.5
STAGE1_REASONING_EFFORT=high
STAGE1_OUTPUT_DIR=/Volumes/t9/extract/openai-runs
STAGE1_CACHE_DIR=/Volumes/t9/extract/openai-runs/_response-cache
STAGE1_MAX_OUTPUT_TOKENS=12000
STAGE1_IMAGE_DETAIL=high
STAGE1_IMAGE_TOKEN_ALLOWANCE=50000
STAGE1_INPUT_USD_PER_MILLION=5.00
STAGE1_CACHED_INPUT_USD_PER_MILLION=0.50
STAGE1_OUTPUT_USD_PER_MILLION=30.00

# OpenAI second-stage transcript moment analysis defaults.
STAGE2_MODEL=gpt-5.5
STAGE2_REASONING_EFFORT=high
STAGE2_OUTPUT_DIR=/Volumes/t9/extract/openai-runs
STAGE2_CACHE_DIR=/Volumes/t9/extract/openai-runs/_response-cache
STAGE2_MAX_OUTPUT_TOKENS=24000
STAGE2_IMAGE_DETAIL=high
STAGE2_IMAGE_TOKEN_ALLOWANCE=50000
STAGE2_VISUAL_INDEX_MAX_IMAGES=24
STAGE2_INPUT_USD_PER_MILLION=5.00
STAGE2_CACHED_INPUT_USD_PER_MILLION=0.50
STAGE2_OUTPUT_USD_PER_MILLION=30.00

# OpenAI third-stage edit planning defaults.
STAGE3_MODEL=gpt-5.5
STAGE3_REASONING_EFFORT=high
STAGE3_OUTPUT_DIR=/Volumes/t9/extract/openai-runs
STAGE3_CACHE_DIR=/Volumes/t9/extract/openai-runs/_response-cache
STAGE3_MAX_OUTPUT_TOKENS=18000
STAGE3_CLIP_COUNT=3
STAGE3_TARGET_ASPECT_RATIO=9:16
STAGE3_TARGET_SECONDS=45
STAGE3_IMAGE_DETAIL=high
STAGE3_IMAGE_TOKEN_ALLOWANCE=50000
STAGE3_VISUAL_INDEX_MAX_IMAGES=24
STAGE3_INPUT_USD_PER_MILLION=5.00
STAGE3_CACHED_INPUT_USD_PER_MILLION=0.50
STAGE3_OUTPUT_USD_PER_MILLION=30.00

# OpenAI fourth-stage post-render critique defaults.
STAGE4_MODEL=gpt-5.5
STAGE4_REASONING_EFFORT=high
STAGE4_OUTPUT_DIR=/Volumes/t9/extract/openai-runs
STAGE4_CACHE_DIR=/Volumes/t9/extract/openai-runs/_response-cache
STAGE4_MAX_OUTPUT_TOKENS=12000
STAGE4_FRAMES_PER_CLIP=14
STAGE4_CONTACT_SHEET_COLUMNS=3
STAGE4_TRANSITION_STRIP_FRAMES=7
STAGE4_TRANSITION_WINDOW_SECONDS=0.48
STAGE4_WAVEFORM_WIDTH=1200
STAGE4_WAVEFORM_HEIGHT=220
STAGE4_SILENCE_NOISE_DB=-35
STAGE4_SILENCE_MIN_DURATION=0.15
STAGE4_IMAGE_DETAIL=high
STAGE4_IMAGE_TOKEN_ALLOWANCE=50000
STAGE4_INPUT_USD_PER_MILLION=5.00
STAGE4_CACHED_INPUT_USD_PER_MILLION=0.50
STAGE4_OUTPUT_USD_PER_MILLION=30.00

# OpenAI fifth-stage re-edit planning defaults.
STAGE5_MODEL=gpt-5.5
STAGE5_REASONING_EFFORT=high
STAGE5_OUTPUT_DIR=/Volumes/t9/extract/openai-runs
STAGE5_CACHE_DIR=/Volumes/t9/extract/openai-runs/_response-cache
STAGE5_MAX_OUTPUT_TOKENS=18000
STAGE5_IMAGE_DETAIL=high
STAGE5_IMAGE_TOKEN_ALLOWANCE=50000
STAGE5_INPUT_USD_PER_MILLION=5.00
STAGE5_CACHED_INPUT_USD_PER_MILLION=0.50
STAGE5_OUTPUT_USD_PER_MILLION=30.00

# Experimental provider capability probe for MP4-as-input behavior.
VIDEO_PROBE_OUTPUT_DIR=/Volumes/t9/extract/api-probes
VIDEO_PROBE_SAMPLE_START_SECONDS=1.8
VIDEO_PROBE_SAMPLE_SECONDS=4
VIDEO_PROBE_SAMPLE_HEIGHT=360
VIDEO_PROBE_SAMPLE_FPS=10
VIDEO_PROBE_SAMPLE_CRF=36
VIDEO_PROBE_SAMPLE_AUDIO_KBPS=32
VIDEO_PROBE_MAX_OUTPUT_TOKENS=300

# OpenAI probe defaults.
VIDEO_PROBE_OPENAI_MODEL=gpt-5.5
VIDEO_PROBE_OPENAI_REASONING_EFFORT=low
VIDEO_PROBE_OPENAI_MODE=direct-input-file
VIDEO_PROBE_OPENAI_INPUT_USD_PER_MILLION=5.00
VIDEO_PROBE_OPENAI_OUTPUT_USD_PER_MILLION=30.00

# Anthropic probe defaults.
VIDEO_PROBE_ANTHROPIC_MODEL=claude-sonnet-4-20250514
VIDEO_PROBE_ANTHROPIC_MODE=files-document
VIDEO_PROBE_ANTHROPIC_INPUT_USD_PER_MILLION=3.00
VIDEO_PROBE_ANTHROPIC_OUTPUT_USD_PER_MILLION=15.00

# Do not put approvals in .env. Pass --approve-api-cost on the command line
# after reviewing the dry-run cost estimate.
