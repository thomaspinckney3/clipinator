# Copy this file to .env and fill in local values.

OPENAI_API_KEY=
ELEVENLABS_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
OPENAI_CLIENT_TIMEOUT_SECONDS=1800
ELEVENLABS_CLIENT_TIMEOUT_SECONDS=1800

# Local response cache identity mode:
# strict = LLM query hash + stage source-file hashes
# query-only = LLM query hash only, useful when reviewing code-only changes
# off = disable local response cache
OPENAI_RESPONSE_CACHE_MODE=strict

# Default transcription settings. CLI flags override these values.
TRANSCRIBE_PROVIDER=openai
TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_OPENAI_MODEL=whisper-1
TRANSCRIBE_ELEVENLABS_MODEL=scribe_v2
TRANSCRIBE_LANGUAGE=en
TRANSCRIBE_OUTPUT_DIR=/Volumes/t9/extract/transcripts
TRANSCRIBE_PROMPT=NASA general-audience video about Artemis, astronauts, moon rocks, space exploration, scientific instruments, and training.
TRANSCRIBE_AUDIO_BITRATE_KBPS=64
TRANSCRIBE_MAX_UPLOAD_MB=24
TRANSCRIBE_WHISPER_1_USD_PER_MINUTE=0.006
TRANSCRIBE_ELEVENLABS_USD_PER_HOUR=0.40
TRANSCRIBE_ELEVENLABS_DIARIZE=false
TRANSCRIBE_ELEVENLABS_TAG_AUDIO_EVENTS=true
TRANSCRIBE_ELEVENLABS_NO_VERBATIM=false
TRANSCRIBE_ELEVENLABS_NUM_SPEAKERS=
TRANSCRIBE_ELEVENLABS_TEMPERATURE=
TRANSCRIBE_ELEVENLABS_SEED=

# Leave empty to let the CLI calculate a safe chunk size.
TRANSCRIBE_CHUNK_SECONDS=

# Cloudflare Stream capture defaults. The token needs Stream Read permission,
# and Stream Write when the utility has to generate downloadable MP4/M4A assets.
CLOUDFLARE_CAPTURE_OUTPUT_DIR=/Volumes/t9/extract/cloudflare-captures
CLOUDFLARE_CAPTURE_INDEX=/Volumes/t9/extract/cloudflare-captures/cloudflare-stream-index.json

# OpenAI strategy-stage planning defaults. CLI flags override these values.
STRATEGY_MODEL=gpt-5.5
STRATEGY_REASONING_EFFORT=high
STRATEGY_OUTPUT_DIR=/Volumes/t9/extract/openai-runs
STRATEGY_CACHE_DIR=/Volumes/t9/extract/openai-runs/_response-cache
STRATEGY_MAX_OUTPUT_TOKENS=12000
STRATEGY_IMAGE_DETAIL=high
STRATEGY_IMAGE_TOKEN_ALLOWANCE=50000
STRATEGY_INPUT_USD_PER_MILLION=5.00
STRATEGY_CACHED_INPUT_USD_PER_MILLION=0.50
STRATEGY_OUTPUT_USD_PER_MILLION=30.00

# OpenAI outline-stage source content map (title + one-line gist per content
# unit). Falls back to the STRATEGY_* family when unset. A cheap labeling task,
# so it defaults to low reasoning effort.
OUTLINE_MODEL=gpt-5.5
OUTLINE_REASONING_EFFORT=low
OUTLINE_BATCH_UNITS=80
# OUTLINE_OUTPUT_DIR, OUTLINE_CACHE_DIR, OUTLINE_*_USD_PER_MILLION also honored.

# OpenAI moments-stage transcript moment analysis defaults.
MOMENTS_MODEL=gpt-5.5
MOMENTS_REASONING_EFFORT=high
MOMENTS_OUTPUT_DIR=/Volumes/t9/extract/openai-runs
MOMENTS_CACHE_DIR=/Volumes/t9/extract/openai-runs/_response-cache
MOMENTS_MAX_OUTPUT_TOKENS=24000
MOMENTS_IMAGE_DETAIL=high
MOMENTS_IMAGE_TOKEN_ALLOWANCE=50000
MOMENTS_VISUAL_INDEX_MAX_IMAGES=24
MOMENTS_INPUT_USD_PER_MILLION=5.00
MOMENTS_CACHED_INPUT_USD_PER_MILLION=0.50
MOMENTS_OUTPUT_USD_PER_MILLION=30.00

# OpenAI plan-stage edit planning defaults.
PLAN_MODEL=gpt-5.5
PLAN_REASONING_EFFORT=high
PLAN_OUTPUT_DIR=/Volumes/t9/extract/openai-runs
PLAN_CACHE_DIR=/Volumes/t9/extract/openai-runs/_response-cache
PLAN_MAX_OUTPUT_TOKENS=18000
PLAN_CLIP_COUNT=3
PLAN_TARGET_ASPECT_RATIO=9:16
PLAN_TARGET_SECONDS=45
PLAN_IMAGE_DETAIL=high
PLAN_IMAGE_TOKEN_ALLOWANCE=50000
PLAN_VISUAL_INDEX_MAX_IMAGES=24
PLAN_INPUT_USD_PER_MILLION=5.00
PLAN_CACHED_INPUT_USD_PER_MILLION=0.50
PLAN_OUTPUT_USD_PER_MILLION=30.00

# OpenAI critique-stage post-render review defaults.
CRITIQUE_MODEL=gpt-5.5
CRITIQUE_REASONING_EFFORT=high
CRITIQUE_OUTPUT_DIR=/Volumes/t9/extract/openai-runs
CRITIQUE_CACHE_DIR=/Volumes/t9/extract/openai-runs/_response-cache
CRITIQUE_MAX_OUTPUT_TOKENS=12000
CRITIQUE_FRAMES_PER_CLIP=14
CRITIQUE_CONTACT_SHEET_COLUMNS=3
CRITIQUE_TRANSITION_STRIP_FRAMES=7
CRITIQUE_TRANSITION_WINDOW_SECONDS=0.48
CRITIQUE_WAVEFORM_WIDTH=1200
CRITIQUE_WAVEFORM_HEIGHT=220
CRITIQUE_SILENCE_NOISE_DB=-35
CRITIQUE_SILENCE_MIN_DURATION=0.15
CRITIQUE_IMAGE_DETAIL=high
CRITIQUE_IMAGE_TOKEN_ALLOWANCE=50000
CRITIQUE_INPUT_USD_PER_MILLION=5.00
CRITIQUE_CACHED_INPUT_USD_PER_MILLION=0.50
CRITIQUE_OUTPUT_USD_PER_MILLION=30.00

# OpenAI revise-stage re-edit planning defaults.
REVISE_MODEL=gpt-5.5
REVISE_REASONING_EFFORT=high
REVISE_OUTPUT_DIR=/Volumes/t9/extract/openai-runs
REVISE_CACHE_DIR=/Volumes/t9/extract/openai-runs/_response-cache
REVISE_MAX_OUTPUT_TOKENS=18000
REVISE_IMAGE_DETAIL=high
REVISE_IMAGE_TOKEN_ALLOWANCE=50000
REVISE_INPUT_USD_PER_MILLION=5.00
REVISE_CACHED_INPUT_USD_PER_MILLION=0.50
REVISE_OUTPUT_USD_PER_MILLION=30.00

# Do not put approvals in .env. Pass --approve-api-cost on the command line
# after reviewing the dry-run cost estimate.
